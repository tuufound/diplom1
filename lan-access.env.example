# Ручной вариант: скопируйте в .env в корне (рядом с docker-compose.yaml),
# подставьте свой IPv4 из ipconfig → «Беспроводная сеть», затем: docker compose up --build
#
# Автоматика (Windows), из корня репозитория:
#   .\docker-lan.cmd
#   (или длиннее: .\scripts\docker-up-lan.ps1 — в PowerShell нужен префикс .\ )
# Linux / WSL / Git Bash:
#   bash scripts/docker-up-lan.sh
# (создаётся .env.lan с вашим IP; compose: docker compose --env-file .env.lan …)

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.0.106
VITE_API_BASE_URL=http://192.168.0.106:8000/api
VITE_PROXY_TARGET=http://backend:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.0.106:3000
